{
  "apiVersion": "chaos-mesh.org/v1alpha1",
  "metadata": {
    "namespace": "chaos-demo",
    "labels": {
      "app.kubernetes.io/part-of": "chaos-lab"
    },
    "name": "06-api-graceful-removal"
  },
  "kind": "PodChaos",
  "spec": {
    "action": "pod-kill",
    "mode": "one",
    "gracePeriod": 30,
    "selector": {
      "namespaces": [
        "chaos-demo"
      ],
      "labelSelectors": {
        "app": "api",
        "app.kubernetes.io/part-of": "chaos-lab"
      }
    }
  }
}
